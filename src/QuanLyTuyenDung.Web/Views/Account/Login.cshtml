@model LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
    Layout = "_AuthLayout";
}

<div class="dang-nhap">
    <div class="dang-nhap-gioi-thieu">
        <span class="logo-icon lon"><i class="bi bi-briefcase-fill"></i></span>
        <h1>Quản lý doanh nghiệp tuyển dụng</h1>
        <p>Hệ thống tiếp nhận hồ sơ, quản lý doanh nghiệp, danh mục yêu cầu và thống kê tuyển dụng
           dành cho cán bộ Trung tâm Dịch vụ việc làm.</p>
        <ul>
            <li><i class="bi bi-check2-circle"></i>Quản lý doanh nghiệp, trụ sở và tình trạng hoạt động</li>
            <li><i class="bi bi-check2-circle"></i>Hồ sơ tuyển dụng theo từng đợt trong năm</li>
            <li><i class="bi bi-check2-circle"></i>Thống kê nhà tuyển dụng theo tháng, năm</li>
        </ul>
    </div>

    <div class="dang-nhap-form">
        <h2>Đăng nhập</h2>
        <p class="text-muted">Dành cho cán bộ trung tâm</p>

        <form asp-action="Login" method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

            <div class="mb-3">
                <label asp-for="TenDangNhap" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                    <input asp-for="TenDangNhap" class="form-control" autofocus autocomplete="username" />
                </div>
                <span asp-validation-for="TenDangNhap" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="MatKhau" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                    <input asp-for="MatKhau" class="form-control" autocomplete="current-password" />
                </div>
                <span asp-validation-for="MatKhau" class="text-danger small"></span>
            </div>
            <div class="form-check mb-4">
                <input asp-for="GhiNho" class="form-check-input" />
                <label asp-for="GhiNho" class="form-check-label"></label>
            </div>
            <button type="submit" class="btn btn-primary w-100 py-2">Đăng nhập</button>
            <p class="text-muted small mt-3 mb-0 text-center">Tài khoản mẫu: <code>admin</code> / <code>admin123</code></p>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
