@model ErrorViewModel
@{
    ViewData["Title"] = "Lỗi";
}

<div class="the text-center py-5">
    <i class="bi bi-exclamation-octagon text-danger display-4"></i>
    <h2 class="mt-3">Đã xảy ra lỗi khi xử lý yêu cầu</h2>
    @if (Model.ShowRequestId)
    {
        <p class="text-muted">Mã yêu cầu: <code>@Model.RequestId</code></p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-2">Về trang tổng quan</a>
</div>
