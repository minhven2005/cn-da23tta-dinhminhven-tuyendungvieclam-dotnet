<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản lý tuyển dụng</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="khung">
        <partial name="_Sidebar" />

        <div class="noi-dung">
            <header class="thanh-tren">
                <button class="btn btn-icon d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebar" aria-label="Mở menu">
                    <i class="bi bi-list"></i>
                </button>
                <div class="thanh-tren-tieude">
                    <h1>@ViewData["Title"]</h1>
                    @if (ViewData["MoTa"] is string moTa)
                    {
                        <p>@moTa</p>
                    }
                </div>
                <div class="dropdown ms-auto">
                    <button class="nguoi-dung dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="avatar">@(User.FindFirst("HoTen")?.Value?.Substring(0, 1) ?? "?")</span>
                        <span class="d-none d-md-inline">@User.FindFirst("HoTen")?.Value</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><span class="dropdown-item-text text-muted small">Đăng nhập: @User.Identity?.Name</span></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </header>

            <main class="vung-chinh">
                <partial name="_ThongBao" />
                @RenderBody()
            </main>

            <footer class="chan-trang">
                &copy; @DateTime.Now.Year · Trung tâm Dịch vụ việc làm · Hệ thống quản lý doanh nghiệp tuyển dụng
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
