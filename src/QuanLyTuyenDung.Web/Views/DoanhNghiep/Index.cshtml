@model List<DoanhNghiep>
@{
    ViewData["Title"] = "Doanh nghiệp tuyển dụng";
    ViewData["MoTa"] = "Thông tin nhà tuyển dụng, trụ sở và tình trạng hoạt động";
    var sapXep = ViewData["SapXep"] as string ?? "ten";
    var tinhTrang = ViewData["TinhTrang"] as TinhTrangHoatDong?;
}

<div class="the">
    <form method="get" class="bo-loc">
        <div class="tim-kiem flex-grow-1">
            <i class="bi bi-search"></i>
            <input type="search" name="tuKhoa" value="@ViewData["TuKhoa"]" class="form-control" placeholder="Tên, tỉnh/thành, người liên hệ..." />
        </div>
        <input type="text" name="maSoThue" value="@ViewData["MaSoThue"]" class="form-control w-auto" placeholder="Tra cứu mã số thuế" />
        <select name="tinhTrang" class="form-select w-auto" asp-items="Html.GetEnumSelectList<TinhTrangHoatDong>()
                .Select(i => { i.Selected = tinhTrang.HasValue && i.Value == ((int)tinhTrang).ToString(); return i; })">
            <option value="">Mọi tình trạng</option>
        </select>
        <select name="sapXep" class="form-select w-auto">
            <option value="ten" selected="@(sapXep == "ten")">Sắp xếp: Tên</option>
            <option value="mst" selected="@(sapXep == "mst")">Sắp xếp: Mã số thuế</option>
            <option value="tinh" selected="@(sapXep == "tinh")">Sắp xếp: Tỉnh/thành</option>
            <option value="moi" selected="@(sapXep == "moi")">Sắp xếp: Mới thêm</option>
        </select>
        <button type="submit" class="btn btn-outline-primary">Lọc</button>
        <a asp-action="Create" class="btn btn-primary ms-lg-auto"><i class="bi bi-plus-lg me-1"></i>Thêm doanh nghiệp</a>
    </form>

    <div class="table-responsive">
        <table class="table bang">
            <thead>
                <tr>
                    <th>Doanh nghiệp</th>
                    <th>Mã số thuế</th>
                    <th class="d-none d-lg-table-cell">Trụ sở</th>
                    <th class="d-none d-md-table-cell">Liên hệ</th>
                    <th class="text-center">Hồ sơ</th>
                    <th>Tình trạng</th>
                    <th style="width:140px"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model)
                {
                    <tr>
                        <td>
                            <a asp-action="Details" asp-route-id="@d.Id" class="fw-semibold">@d.TenDoanhNghiep</a>
                            <div class="text-muted small">@d.TinhThanh</div>
                        </td>
                        <td><code>@d.MaSoThue</code></td>
                        <td class="d-none d-lg-table-cell small">@d.DiaChiTruSo</td>
                        <td class="d-none d-md-table-cell small">
                            @d.NguoiLienHe<br /><span class="text-muted">@d.SoDienThoai</span>
                        </td>
                        <td class="text-center">@d.HoSoTuyenDungs.Count</td>
                        <td><span class="@BadgeHelper.Css(d.TinhTrang)">@d.TinhTrang.TenHienThi()</span></td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@d.Id" class="btn btn-icon" title="Chi tiết"><i class="bi bi-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@d.Id" class="btn btn-icon" title="Sửa"><i class="bi bi-pencil"></i></a>
                            <form asp-action="Delete" asp-route-id="@d.Id" method="post" class="d-inline"
                                  data-xac-nhan="Xóa doanh nghiệp &quot;@d.TenDoanhNghiep&quot;?">
                                <button type="submit" class="btn btn-icon text-danger" title="Xóa"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (Model.Count == 0)
        {
            <p class="trong">Không tìm thấy doanh nghiệp phù hợp.</p>
        }
    </div>
</div>
